@@ -0,0 +1,144 @@
+extends "res://scripts/environment/env010_layout.gd"
+## Branch-local walk-plane preview. Original builder and manifest remain unchanged.
+@export_file("*.json") var revision_path: String = "res://assets/environment/env010/layout_walkplane_v2.json"
+var _revision: Dictionary = {}
+
+func _blob_sha(path: String) -> String:
+    var bytes: PackedByteArray = FileAccess.get_file_as_bytes(path)
+    var payload: PackedByteArray = ("blob " + str(bytes.size())).to_utf8_buffer()
+    payload.append(0)
+    payload.append_array(bytes)
+    var hash_context := HashingContext.new()
+    if hash_context.start(HashingContext.HASH_SHA1) != OK:
+        return ""
+    if hash_context.update(payload) != OK:
+        return ""
+    return hash_context.finish().hex_encode()
+
+func _read_revision() -> Dictionary:
+    var base_value: Variant = JSON.parse_string(FileAccess.get_file_as_string(manifest_path))
+    var overlay_value: Variant = JSON.parse_string(FileAccess.get_file_as_string(revision_path))
+    if not base_value is Dictionary or not overlay_value is Dictionary:
+        _issue("Cannot parse base manifest or walk-plane revision")
+        return {}
+    var data: Dictionary = base_value
+    _revision = overlay_value
+    if str(_revision.get("schema", "")) != "ashen.env010.walkplane_revision.v2":
+        _issue("Unsupported walk-plane revision schema")
+        return {}
+    if str(_revision.get("base_manifest", "")) != manifest_path:
+        _issue("Revision targets a different manifest")
+        return {}
+    if _blob_sha(manifest_path) != str(_revision.get("base_manifest_git_blob_sha", "")):
+        _issue("Base manifest changed; review the revision before activation")
+        return {}
+    var movement: Dictionary = _revision.get("movement_contract", {})
+    var movement_path: String = str(movement.get("source", ""))
+    if not FileAccess.file_exists(movement_path) or _blob_sha(movement_path) != str(movement.get("source_git_blob_sha", "")):
+        _issue("Player controller changed; review the movement contract")
+        return {}
+    var resource_changes: Dictionary = _revision.resource_overrides
+    for key in resource_changes:
+        if not data.resources.has(key):
+            _issue("Unknown resource override: " + key)
+            return {}
+        var resource_spec: Dictionary = resource_changes[key]
+        data.resources[key] = [resource_spec.relative_path, resource_spec.mode]
+    var pending: Dictionary = _revision.instance_y_overrides_m.duplicate()
+    for raw in data.instances:
+        var full_id: String = str(data.instance_id_prefix) + str(raw[0])
+        if pending.has(full_id):
+            var value: Variant = pending[full_id]
+            if not (value is float or value is int) or not is_finite(float(value)):
+                _issue("Invalid Y override: " + full_id)
+                return {}
+            raw[2][1] = float(value)
+            pending.erase(full_id)
+    if not pending.is_empty():
+        _issue("Unknown instance IDs in walk-plane revision")
+        return {}
+    var fixture_changes: Dictionary = _revision.fixture_overrides
+    for key in fixture_changes:
+        if not data.fixtures.has(key):
+            _issue("Unknown fixture override: " + key)
+            return {}
+        var fixture_spec: Dictionary = data.fixtures[key]
+        fixture_spec.merge(fixture_changes[key], true)
+    var route: Dictionary = data.reserved_route
+    route.merge(_revision.reserved_route_override, true)
+    var preserved: Dictionary = _revision.preserve
+    if data.instances.size() != int(preserved.instance_count) or data.resources.size() != int(preserved.resource_type_count) or data.fixtures.size() != int(preserved.local_fixture_count):
+        _issue("Revision changed a protected layout count")
+        return {}
+    return data
+
+func _fixture(key: String) -> Node3D:
+    var body: Node3D = super._fixture(key)
+    var spec: Dictionary = _data.fixtures[key]
+    var visual := body.get_node("Visual") as MeshInstance3D
+    visual.position = _vec(spec.get("visual_local_offset_m", [0,0,0]))
+    visual.visible = bool(spec.get("visual_enabled", true))
+    var collision_body := body as StaticBody3D
+    collision_body.collision_layer = int(spec.get("collision_layer", 1))
+    collision_body.collision_mask = int(spec.get("collision_mask", 0))
+    for child in body.get_children():
+        if child is CollisionShape3D:
+            var shape := child as CollisionShape3D
+            shape.disabled = not bool(spec.get("collision_enabled", true))
+            shape.position = _vec(spec.get("collision_local_offset_m", [0,0,0]))
+    return body
+
+func _ready() -> void:
+    _data = _read_revision()
+    if _data.is_empty():
+        set_meta("env010_build_report", {"instances":0,"issues":_issues,"engine_validated":false,"revision_applied":false})
+        return
+    var props := Node3D.new()
+    props.name = "Props"
+    add_child(props)
+    for raw in _data.instances:
+        var suffix: String = str(raw[0])
+        var key: String = str(raw[1])
+        var node: Node3D
+        if key.begins_with("@"):
+            node = _fixture(key)
+        else:
+            var entry: Array = _data.resources[key]
+            var path: String = str(_data.asset_root) + str(entry[0])
+            var packed := load(path) as PackedScene
+            if packed == null:
+                _issue("Missing scene: " + path)
+                continue
+            var instance: Node = packed.instantiate()
+            if not instance is Node3D:
+                _issue("Resource root is not Node3D: " + path)
+                if instance != null:
+                    instance.free()
+                continue
+            node = instance as Node3D
+        node.name = str(_data.instance_id_prefix) + suffix
+        node.position = _vec(raw[2])
+        node.rotation.y = deg_to_rad(float(raw[3]))
+        node.scale = Vector3.ONE
+        node.add_to_group("env010_" + str(raw[4]))
+        var options: Dictionary = _data.overrides.get(suffix, {})
+        node.set_meta("env010_asset", key)
+        node.set_meta("env010_role", str(raw[4]))
+        if options.has("world_object_id"):
+            node.set_meta("proposed_world_object_id", str(options.world_object_id))
+            node.set_meta("loot_binding", "not implemented or server-registered")
+        props.add_child(node)
+        _adapt(node, options)
+        if str(raw[4]) == "roof":
+            var target: Node = node if str(_data.resources[key][1]) == "visual" else node.get_node_or_null("Visual")
+            if target == null:
+                _issue("Missing roof Visual child: " + suffix)
+            else:
+                target.add_to_group(str(_data.camera_review.roof_visual_group))
+        _built += 1
+    if _built != int(_data.scope.expected_instances):
+        _issue("Unexpected instance count: " + str(_built))
+    if preview_services:
+        _preview()
+    set_meta("env010_build_report", {"instances":_built,"issues":_issues,"engine_validated":false,"revision_applied":_issues.is_empty(),"stage":"walk-plane v2 static preview; traversal and visual review required","revision_path":revision_path})
+    print("ENV010_WALKPLANE instances=", _built, " issues=", _issues.size())
--- /dev/null
+++ b/tests/test_env010_walkplane.gd
@@ -0,0 +1,151 @@
+extends SceneTree
+## Run after Godot 4.3 import: --headless --path . --script res://tests/test_env010_walkplane.gd
+signal drive_finished
+var _failures: Array[String] = []
+var _checks: int = 0
+var _player: NetPlayer
+var _goals: Array[Vector3] = []
+var _driving: bool = false
+var _goal_index: int = 0
+var _leg_ticks: int = 0
+var _integrations: int = 0
+var _max_y_error: float = 0.0
+var _blockers: Dictionary = {}
+
+func _initialize() -> void:
+    call_deferred("_run")
+
+func _check(ok: bool, label: String) -> void:
+    _checks += 1
+    if not ok:
+        _failures.append(label)
+        printerr("FAIL: " + label)
+
+func _point(value: Array) -> Vector3:
+    return Vector3(float(value[0]), float(value[1]), float(value[2]))
+
+func _physics_process(delta: float) -> bool:
+    if not _driving:
+        return false
+    var offset: Vector3 = _goals[_goal_index] - _player.position
+    offset.y = 0.0
+    if offset.length() <= 0.025:
+        _goal_index += 1
+        _leg_ticks = 0
+        if _goal_index == _goals.size():
+            _driving = false
+            drive_finished.emit()
+        return false
+    _leg_ticks += 1
+    if _leg_ticks > 600:
+        _check(false, "Route blocked at leg " + str(_goal_index) + " position=" + str(_player.position) + " colliders=" + str(_blockers.keys()))
+        _driving = false
+        drive_finished.emit()
+        return false
+    var intent: Vector3 = offset.normalized() * minf(1.0, offset.length() / (NetProtocol.WALK_SPEED * delta))
+    _player.integrate(intent, delta)
+    _integrations += 1
+    _max_y_error = maxf(_max_y_error, absf(_player.position.y))
+    for i in range(_player.get_slide_collision_count()):
+        var hit: KinematicCollision3D = _player.get_slide_collision(i)
+        var collider: Object = hit.get_collider()
+        if collider is Node:
+            _blockers[str((collider as Node).get_path())] = true
+    return false
+
+func _run() -> void:
+    var packed := load("res://scenes/environment/env010_watchhouse_courtyard.tscn") as PackedScene
+    _check(packed != null, "Load activated preview scene")
+    if packed == null:
+        _finish()
+        return
+    var layout := packed.instantiate() as Node3D
+    _check(layout != null, "Preview root is Node3D")
+    if layout == null:
+        _finish()
+        return
+    layout.set("preview_services", false)
+    root.add_child(layout)
+    await physics_frame
+    await physics_frame
+    var report: Dictionary = layout.get_meta("env010_build_report", {})
+    _check(bool(report.get("revision_applied", false)), "Overlay applied without builder issues")
+    _check(int(report.get("instances", 0)) == 79, "79 layout instances")
+    var data: Dictionary = layout.get("_data")
+    var props: Node = layout.get_node_or_null("Props")
+    if not bool(report.get("revision_applied", false)) or props == null:
+        layout.free()
+        _finish()
+        return
+    var revision: Dictionary = layout.get("_revision")
+    var y_changes: Dictionary = revision.instance_y_overrides_m
+    for id in y_changes:
+        var item := props.get_node_or_null(NodePath(id)) as Node3D
+        _check(item != null, "Retained ID " + id)
+        if item != null:
+            _check(is_equal_approx(item.position.y, float(y_changes[id])), "Applied Y " + id)
+    for i in range(1, 4):
+        var floor_node: Node = props.get_node("env010_floor_" + str(i))
+        _check(not floor_node is CollisionObject3D and floor_node.find_children("*", "CollisionObject3D", true, false).is_empty(), "Paving visual has no physics body " + str(i))
+    var ramp: Node = props.get_node("env010_entry_ramp")
+    var ramp_shapes: int = 0
+    for child in ramp.get_children():
+        if child is CollisionShape3D:
+            ramp_shapes += 1
+            _check((child as CollisionShape3D).disabled, "Transition collider disabled")
+    _check(ramp_shapes == 1, "Retained transition fixture shape")
+    var ground: Node = props.get_node("env010_ground")
+    var route: Array = data.reserved_route.waypoints_m
+    _check(route.size() == 7, "Seven reserved route waypoints")
+    if route.size() != 7:
+        layout.free()
+        _finish()
+        return
+    for value in route:
+        var point: Vector3 = _point(value)
+        _check(is_zero_approx(point.y), "Route uses Y=0")
+        var query := PhysicsRayQueryParameters3D.create(point + Vector3(0,0.15,0), point - Vector3(0,0.25,0), 1)
+        query.collide_with_areas = false
+        var contact: Dictionary = layout.get_world_3d().direct_space_state.intersect_ray(query)
+        _check(contact.get("collider") == ground, "Ground is route walking surface " + str(point))
+        if not contact.is_empty():
+            var position: Vector3 = contact.position
+            _check(absf(position.y) < 0.0001, "Ground contact Y=0")
+    _player = NetPlayer.create(1, "env010-traversal-test", _point(route[0]), 0.0, Color(0.6,0.7,0.6))
+    root.add_child(_player)
+    await physics_frame
+    await physics_frame
+    var capsule_count: int = 0
+    for child in _player.get_children():
+        if child is CollisionShape3D:
+            var shape: Shape3D = (child as CollisionShape3D).shape
+            if shape is CapsuleShape3D:
+                capsule_count += 1
+                var capsule := shape as CapsuleShape3D
+                _check(is_equal_approx(capsule.radius, 0.35) and is_equal_approx(capsule.height, 1.7), "Unmodified real player capsule")
+    _check(capsule_count == 1, "One real controller capsule")
+    for i in range(1, route.size()):
+        _goals.append(_point(route[i]))
+    for i in range(route.size() - 2, -1, -1):
+        _goals.append(_point(route[i]))
+    _driving = true
+    await drive_finished
+    _check(_goal_index == _goals.size() and _goals.size() == 12, "Exterior-to-supply-approach-and-return completed")
+    _check(_integrations > 0, "Movement used real NetPlayer.integrate")
+    _check(_max_y_error < 0.0001, "Controller remained on Y=0")
+    _check(_player.position.distance_to(_point(route[0])) <= 0.025, "Returned to initial exterior position")
+    _player.free()
+    layout.free()
+    await physics_frame
+    _finish()
+
+func _finish() -> void:
+    var result: Dictionary = {"passed":_failures.is_empty(),"checks":_checks,"failures":_failures,"reached_route_legs":_goal_index,"integrate_calls":_integrations,"maximum_y_error_m":_max_y_error,"collision_nodes":_blockers.keys(),"engine":Engine.get_version_info(),"scope":"Actual unchanged controller in static ENV-010 preview; no live loot, moving door, multiplayer, rendered visual or performance certification"}
+    var output := FileAccess.open("user://env010-walkplane-validation-report.json", FileAccess.WRITE)
+    if output == null:
+        _check(false, "Write validation report")
+    else:
+        output.store_string(JSON.stringify(result, "  "))
+        output.close()
+    print("ENV010_WALKPLANE_VALIDATION checks=", _checks, " failures=", _failures.size())
+    quit(0 if _failures.is_empty() else 1)
