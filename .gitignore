# Godot 4+ local cache, imported assets, and shader cache
.godot/

# OS-specific metadata
.DS_Store
Thumbs.db
desktop.ini

# Exported builds and local crash logs
builds/
export/
*.log
*.tmp

# Local editor/IDE settings
.vscode/
.idea/
*.swp

# Generated by Godot when it imports the environment kit (rebuilt on every import, CI included);
# the kit itself is the .glb and source files under assets/environment.
assets/environment/**/*.import
assets/environment/**/*_0.png
# Written to the repo root by tests/test_env00*_collisions.gd on every run.
/validation-report.json
/env0*-validation-report.json

# The 3D quality benchmark pack (CC0, about 150 MB): fetched by tools/fetch_benchmark_assets.py, never committed.
assets/reference/benchmark/
