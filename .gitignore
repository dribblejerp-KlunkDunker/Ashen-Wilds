# Godot 4+ local cache, imported assets, and shader cache
.godot/

# OS-specific metadata
.DS_Store
Thumbs.db
desktop.ini

# Exported builds and local crash logs
builds/
export/
*.log
*.tmp

# Local editor/IDE settings
.vscode/
.idea/
*.swp

# Autonomous Project Master: keep the gate config, not the session evidence
.agent/master/*
!.agent/master/config.json

# Python bytecode from tools/visual_benchmark.py
__pycache__/

# Every cut of the reference sheets: rebuilt by tools/slice_sheets.py, only assets/game/ is committed
assets/sheets/
