{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octave.invalid/schemas/mod.v1.json",
  "title": "Octave mod manifest and content (schema v1)",
  "x-schemaVersion": 1,
  "description": "One JSON file = one mod. Everything is data; nothing is executed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "author",
    "maps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,23}$",
      "description": "Mod id (3-24 characters). Namespaces everything the mod adds."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^<>&`\\\\\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff]+$",
      "description": "Plain text. Markup characters (< > &), backticks, backslashes and control characters are refused."
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^<>&`\\\\\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff]+$",
      "description": "Plain text. Markup characters (< > &), backticks, backslashes and control characters are refused."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^<>&`\\\\\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff]+$",
      "description": "Plain text. Markup characters (< > &), backticks, backslashes and control characters are refused."
    },
    "maps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "map.v1.json"
      }
    },
    "enemies": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "enemy.v1.json"
      }
    },
    "items": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "npcs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/npc"
      }
    },
    "quests": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "quest.v1.json"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "desc",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,23}$",
          "description": "Lowercase local id. The game namespaces it as mod:<modid>:<id>."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[^<>&`\\\\\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff]+$",
          "description": "Plain text. Markup characters (< > &), backticks, backslashes and control characters are refused."
        },
        "desc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^<>&`\\\\\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff]+$",
          "description": "Plain text. Markup characters (< > &), backticks, backslashes and control characters are refused."
        },
        "kind": {
          "enum": [
            "trinket",
            "tonic",
            "draught",
            "key"
          ],
          "description": "trinket = sellable valuable, tonic = heals, draught = restores voice, key = quest item"
        },
        "sprite": {
          "enum": [
            "loot",
            "gear",
            "chest",
            "coil",
            "cores"
          ],
          "default": "loot"
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "description": "tonic/draught strength, clamped"
        },
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "trinket value, clamped"
        }
      }
    },
    "npc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "sprite",
        "portrait",
        "greet"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,23}$",
          "description": "Lowercase local id. The game namespaces it as mod:<modid>:<id>."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[^<>&`\\\\\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff]+$",
          "description": "Plain text. Markup characters (< > &), backticks, backslashes and control characters are refused."
        },
        "sprite": {
          "enum": [
            "townsman",
            "townswoman",
            "hetty",
            "hob",
            "nell",
            "orla",
            "aldric",
            "tam",
            "bettany",
            "pim",
            "harrow",
            "tongueless"
          ]
        },
        "portrait": {
          "enum": [
            "townsman",
            "townswoman",
            "harrow",
            "hetty",
            "hob",
            "mags",
            "nell",
            "orla",
            "pim",
            "tam",
            "quist",
            "wren",
            "aldric",
            "bettany",
            "rooke",
            "tongueless"
          ]
        },
        "greet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[^<>&`\\\\\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff]+$",
          "description": "Plain text. Markup characters (< > &), backticks, backslashes and control characters are refused."
        }
      }
    }
  },
  "x-limits": {
    "fileCharacters": 131072,
    "distinctFlags": 32,
    "enemiesPerMap": 40
  }
}
